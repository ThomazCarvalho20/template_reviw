# Repositório de execução: somente os caminhos liberados abaixo são enviados.
# Os demais arquivos continuam disponíveis localmente.
/*
!/.gitignore
!/.dockerignore
!/README.md
!/manage.py
!/requirements.txt
!/Dockerfile
!/docker-compose.prod.yml
!/apps/
!/config/
!/deploy/
!/scripts/
!/static/
!/templates/
!/docs/

# Somente o entrypoint e o guia de implantação são necessários nesses diretórios.
/scripts/*
!/scripts/entrypoint.sh
/docs/*
!/docs/DEPLOYMENT.md

# Testes e ferramentas de desenvolvimento ficam somente no ambiente local.
tests/
tests.py
tests_*.py
test_*.py
*_test.py
/static/css/tailwind.input.css

# Artefatos Python, dependências instaladas e caches.
__pycache__/
*.py[cod]
*.so
*.egg
*.egg-info/
.venv/
venv/
env/
ENV/
node_modules/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/
build/
dist/

# Bancos, uploads, estáticos coletados e backups são dados locais.
*.sqlite3
*.sqlite3-*
*.db
*.db-*
*.dump
*.backup
*.bak
/media/
/staticfiles/
/.local-backups/

# Apenas exemplos sem credenciais reais são versionados.
.env
.env.*
!/.env.example
!/.env.production.example
*.pem
*.key
*.p12
*.pfx

# Logs, arquivos temporários e metadados locais.
*.log
*.tmp
*.swp
*.swo
*~
.DS_Store
Thumbs.db
